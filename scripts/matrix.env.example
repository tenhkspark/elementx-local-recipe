# matrix.env.example — environment for a Hermes Agent Matrix bot.
# Copy to .env (chmod 600) inside the bot's HERMES_HOME and fill in.
# The bot gateway loads this file automatically at startup.

# Homeserver the bot talks to (local only — same machine as Conduit)
MATRIX_HOMESERVER=http://127.0.0.1:8008

# Bot identity (created with create-account.sh)
MATRIX_USER_ID=@bot:matrix.example.ts.net
MATRIX_PASSWORD=CHANGE_ME
# Keep the device_id STABLE across restarts: logging in with the same
# device_id reuses the session instead of piling up ghost devices.
MATRIX_DEVICE_ID=botdev01

# Only these users may talk to the bot (full actor IDs)
MATRIX_ALLOWED_USERS=@you:matrix.example.ts.net

# Room the bot treats as "home" (where it greets / reports)
MATRIX_HOME_ROOM=!REPLACE_WITH_ROOM_ID:matrix.example.ts.net

# This stack runs WITHOUT end-to-end encryption (the bot cannot do E2EE on
# macOS — no libolm). Rooms must stay unencrypted or the bot cannot read them.
MATRIX_E2EE_MODE=optional

# Brain: any OpenAI-compatible endpoint. Example points at a local LiteLLM
# board that fronts a self-hosted model server.
OPENAI_BASE_URL=http://127.0.0.1:4000/v1
OPENAI_API_KEY=CHANGE_ME_OR_LOCAL_BOARD_TOKEN
